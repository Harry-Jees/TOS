# SandboxOS configuration. Copy this file to ".env" and fill in your key.
# The .env file is read at startup; never commit it.

# --- agent brain (OpenAI-compatible endpoint) -------------------------------
# NVIDIA NIM (default): get a key at https://build.nvidia.com  -> "Get API Key"
SANDBOX_LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Aliases also accepted: NVIDIA_API_KEY, OPENAI_API_KEY

# Any OpenAI-compatible endpoint works:
#   NVIDIA NIM      https://integrate.api.nvidia.com/v1
#   OpenAI          https://api.openai.com/v1
#   OpenRouter      https://openrouter.ai/api/v1
#   Groq            https://api.groq.com/openai/v1
#   local Ollama    http://localhost:11434/v1
SANDBOX_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Pick a model that supports tool calling. Suggested:
#   meta/llama-3.3-70b-instruct          (default, strong tool use)
#   nvidia/llama-3.3-nemotron-super-49b-v1.5
#   qwen/qwen2.5-coder-32b-instruct
#   deepseek-ai/deepseek-v3.1
SANDBOX_LLM_MODEL=meta/llama-3.3-70b-instruct

# --- agent behaviour --------------------------------------------------------
# Set to "scripted" to force the offline built-in brain (no key needed).
# SANDBOX_AGENT=scripted
# SANDBOX_AGENT_MAX_STEPS=40
# SANDBOX_PORT=8787
